[Unit]
Description=platmon platform monitor
After=network.target

[Service]
WorkingDirectory=/opt/platmon
ExecStart=/usr/bin/python3 -m frontends.server 8080
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
